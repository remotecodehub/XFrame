            // await ApiService.ResendConfirmationEmailAsync(
            //     new ResendConfirmationEmailRequest
            //     {
            //         AdditionalData = null,
            //         Email = email
            //     },
            //     cancellationToken);

            Snackbar.Add(
                "Se existir uma conta associada a este e-mail, uma mensagem foi enviada com as instruções.",
                Severity.Info);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            Snackbar.Add(
                "A operação foi cancelada.",
                Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Falha ao reenviar o e-mail de confirmação: {ex.Message}",
                Severity.Error);
        }
    }

