@page "/login" 
@inherits LayoutComponentBase
@layout Layout.CommonLayout
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center min-vh-100 py-8">
    <MudPaper Elevation="4" Class="pa-6 width-full rounded-lg">

        <MudCard Outlined="true" Class="d-flex flex-column align-center ma-6 pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="MudColor.Primary" Size="Size.Large" Class="mb-2" />
                        <MudText Typography="Typography.h5" Color="MudColor.Primary" Align="Align.Center" Style="font-weight: 600;">
                            Acessar ou Registrar Conta
                        </MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Color="MudColor.Secondary" Align="Align.Center">
                    Insira suas credenciais para continuar
                </MudText>
            </MudCardContent>
        </MudCard>
         
        <MudForm @ref="_form" Model="@_model">
            <MudStack Spacing="3">

                <MudTextField T="string"
                              @bind-Value="_model.Email"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Required="true"
                              RequiredError="O e-mail é obrigatório."
                              AutoComplete="username" />

                <MudTextField T="string"
                              @bind-Value="_model.Password"
                              Label="Senha"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Required="true"
                              RequiredError="A senha é obrigatória."
                              AutoComplete="current-password" />
                               
                <MudPaper Class="pa-4 my-2" Outlined="true">
                    <MudText Typography="Typography.caption" Color="MudColor.Dark" Class="mb-2 d-block">Possui dúvidas com a conta?</MudText>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Text"
                                   Color="MudColor.Error"
                                   FullWidth="true"
                                   OnClick="@(async () => await ForgotPassword(_model.Email))">
                            Esqueceu a senha?
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="MudColor.Warning"
                                   FullWidth="true"
                                   OnClick="@(async () => await ResendConfirmation(_model.Email))">
                            Reenviar e-mail de confirmação
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <MudButton Variant="Variant.Filled"
                           Color="MudColor.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Disabled="@_isLoginLoading"
                           OnClick="@(async () => await LoginAsync())"
                           Class="mt-2 py-3">
                    @if (_isLoginLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Entrando...</MudText>
                    }
                    else
                    {
                        <MudText>Entrar</MudText>
                    }
                </MudButton>

                <MudDivider Class="my-2" />
                 
                <MudButton Variant="Variant.Outlined"
                           Color="MudColor.Success"
                           FullWidth="true"
                           Class="py-2"
                           Disabled="@_isRegisterLoading"
                           OnClick="@(async () => await RegisterAsync())">
                    @if (_isRegisterLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Criando...</MudText>
                    }
                    else
                    {
                        <MudText>Criar nova conta</MudText>
                    }
                </MudButton>

            </MudStack>
        </MudForm>

    </MudPaper>
</MudContainer>


